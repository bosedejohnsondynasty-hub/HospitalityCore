# ---------------------------------------------------------------------------
# Hospitality Core - example environment configuration
# Copy to .env and change every value marked CHANGE_ME before any real use.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
API_PORT=4000
API_HOST=0.0.0.0

# Public origin of the web client (used for CORS and secure cookie settings)
APP_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://hospitality_app:CHANGE_ME_APP_DB_PASSWORD@127.0.0.1:5432/hospitality_core
# Owner/migration connection (superuser or schema owner). Only used by scripts.
DATABASE_ADMIN_URL=postgres://postgres:CHANGE_ME_ADMIN_DB_PASSWORD@127.0.0.1:5432/hospitality_core
APP_DB_USER=hospitality_app
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# Refuse to start if the runtime connection is a superuser or table owner.
REQUIRE_RESTRICTED_DB_ROLE=true

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=60
PASSWORD_MIN_LENGTH=12
# One-time token required to run first-run tenant onboarding.
SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN
# Enable the guarded /api/v1/setup/bootstrap endpoint for first run only.
# Set to false (and restart) as soon as the tenant exists.
ALLOW_API_SETUP=true
# Comma separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Payments - provider secrets stay in the environment, never in the database.
# Webhook signatures are verified with these values.
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
# When true, the API will not call provider verification endpoints and only
# accepts signed webhooks. Keep false in production.
PAYMENTS_ALLOW_OFFLINE_VERIFY=false

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
