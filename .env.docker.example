# ---------------------------------------------------------------------------
# Hospitality Core - Production Docker Environment
# Copy to .env and change EVERY value marked CHANGE_ME before deployment.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=production
API_PORT=4000
API_HOST=0.0.0.0
WEB_PORT=8080

# Public origin of the web client (used for CORS and secure cookie settings)
APP_ORIGIN=http://localhost:8080

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=hospitality_core
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
APP_DB_USER=hospitality_app
APP_DB_PASSWORD=CHANGE_ME_APP_DB_PASSWORD

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
SESSION_TTL_MINUTES=480
SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN
ALLOW_API_SETUP=true
CORS_ORIGINS=http://localhost:8080

# ---------------------------------------------------------------------------
# Payments - optional; leave blank if not used
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SECRET_HASH=
PAYMENTS_ALLOW_OFFLINE_VERIFY=false

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
LOG_LEVEL=info
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
BACKUP_RETENTION_DAYS=30